<?xml version="1.0"?>
<package format="3">
  <name>vif_orbslam3</name>
  <version>0.3.0</version>
  <description>ROS 2 stereo-inertial adapter for the pinned ORB-SLAM3 backend.</description>
  <maintainer email="mohit.singh@users.noreply.github.com">Mohit Singh</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>boost</depend>
  <depend>cv_bridge</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>nav_msgs</depend>
  <depend>opencv</depend>
  <depend>openssl</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>vif_interfaces</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
