 #include <iostream>

 #include <mutex>
@@ -4065,6 +4067,46 @@ int Tracking::GetMatchesInliers()
     return mnMatchesInliers;
 }

+float Tracking::GetMeanReprojectionError()
+{
+    if(!mCurrentFrame.HasPose() || !mCurrentFrame.mpCamera)
+        return -1.0f;
+
+    const size_t count = std::min(
+        mCurrentFrame.mvpMapPoints.size(),
+        std::min(mCurrentFrame.mvbOutlier.size(), mCurrentFrame.mvKeysUn.size()));
+    if(count == 0)
+        return -1.0f;
+
+    const Sophus::SE3f camera_from_world = mCurrentFrame.GetPose();
+    double residual_sum = 0.0;
+    size_t accepted = 0;
+    for(size_t index = 0; index < count; ++index)
+    {
+        MapPoint* map_point = mCurrentFrame.mvpMapPoints[index];
+        if(!map_point || mCurrentFrame.mvbOutlier[index])
+            continue;
+
+        const Eigen::Vector3f camera_point =
+            camera_from_world * map_point->GetWorldPos();
+        if(!camera_point.allFinite() || camera_point.z() <= 0.0f)
+            continue;
+        const Eigen::Vector2f projected = mCurrentFrame.mpCamera->project(camera_point);
+        const cv::Point2f & observed = mCurrentFrame.mvKeysUn[index].pt;
+        if(!projected.allFinite() || !std::isfinite(observed.x) ||
+           !std::isfinite(observed.y))
+        {
+            continue;
+        }
+        const double delta_x = static_cast<double>(projected.x()) - observed.x;
+        const double delta_y = static_cast<double>(projected.y()) - observed.y;
+        residual_sum += std::sqrt(delta_x * delta_x + delta_y * delta_y);
+        ++accepted;
+    }
+
+    return accepted > 0 ? static_cast<float>(residual_sum / accepted) : -1.0f;
+}
+
 void Tracking::SaveSubTrajectory(string strNameFile_frames, string strNameFile_kf, string strFolder)
 {
     mpSystem->SaveTrajectoryEuRoC(strFolder + strNameFile_frames);
